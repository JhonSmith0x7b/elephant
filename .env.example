# Local database: npm run db:up (LOCAL_DB_PASSWORD belongs in .env for Compose)
DATABASE_URL=postgresql://reader:YOUR_LOCAL_PASSWORD@127.0.0.1:55432/reader
# Development only. Ignored in production and on Vercel.
LOCAL_DEV_AUTH_BYPASS=1
# For a private production deployment, generate a random secret of 32+ characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=
# Used ONLY by npm run auth:setup; remove from hosted runtime after initialization.
ADMIN_PASSWORD=

# Optional: use cloudflare only on local proxy networks returning Fake-IP DNS answers.
# Uses verified HTTPS to fixed public DNS; private/reserved targets remain blocked.
# Vercel normally needs no override.
RSS_DNS_MODE=system
# Optional development-only allowlist: hostnames/IPs, comma-separated, no ports.
# Allowed hosts use system DNS; production and Vercel ignore this setting.
# RSS_LOCAL_FEED_HOSTS=localhost,127.0.0.1,::1

# Hosted cron only. Generate a random secret and configure it on Vercel.
# The local worker calls the sync service directly and needs no cron secret.
CRON_SECRET=
# Built-in Vercel cron runs daily for Hobby compatibility (1440 minutes).
# On Pro, change vercel.json to a more frequent tick AND set this to its interval.
# Local worker ticks every minute; the default selectable minimum there is 15.
# SYNC_TRIGGER_INTERVAL_MINUTES=1440
